# Model to use (e.g. gpt-4o-mini, qwen3.8-27b-uncensored-mtp:latest, etc.)
OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible API (Ollama, LM Studio, OpenRouter, Cloudflare tunnel, etc.)
# Leave empty for official OpenAI API
# Examples:
# OPENAI_ENDPOINT=http://localhost:11434/v1      # Ollama
# OPENAI_ENDPOINT=http://localhost:1234/v1       # LM Studio
# OPENAI_ENDPOINT=https://openrouter.ai/api/v1   # OpenRouter
OPENAI_ENDPOINT=

# API Key (use "ollama" / "lm-studio" / "not-needed" for local providers, or your OpenAI API key)
OPENAI_APIKEY=your_openai_or_openrouter_api_key_here

# WeatherAPI Key for current weather tool (from https://www.weatherapi.com/)
WEATHER_API_KEY=your_weatherapi_key_here

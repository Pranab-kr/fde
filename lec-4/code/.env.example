# Server Port (default: 3000)
PORT=3000

# Model to use (e.g. gpt-4o-mini, qwen3.5-0.8b, etc.)
OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible API (Ollama, LM Studio, OpenRouter, etc.)
# Leave empty for official OpenAI API
# Examples:
# OPENAI_ENDPOINT=http://localhost:1234/v1       # LM Studio
# OPENAI_ENDPOINT=http://localhost:11434/v1      # Ollama
# OPENAI_ENDPOINT=https://openrouter.ai/api/v1   # OpenRouter
OPENAI_ENDPOINT=http://localhost:1234/v1

# API Key (use "lm-studio" / "ollama" / "not-needed" for local providers, or your OpenAI API key)
OPENAI_APIKEY=lm-studio

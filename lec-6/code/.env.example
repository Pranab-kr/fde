# Model to use (e.g. gpt-4o-mini, llama3, qwen3.5-0.8b, etc.)
OPENAI_MODEL=gpt-4o-mini

# API Key (use "not-needed" or "ollama" / "lm-studio" for local providers)
OPENAI_API_KEY=your-api-key-here

# Custom Base URL for OpenAI-compatible providers (Groq, Ollama, OpenRouter, LM Studio, etc.)
# Leave empty to use official OpenAI API
# Examples:
# OPENAI_BASE_URL=http://localhost:11434/v1          # Ollama
# OPENAI_BASE_URL=http://localhost:1234/v1           # LM Studio
# OPENAI_BASE_URL=https://api.groq.com/openai/v1     # Groq
# OPENAI_BASE_URL=https://openrouter.ai/api/v1       # OpenRouter
OPENAI_BASE_URL=

# Port to run the server on (default: 3000)
PORT=3000

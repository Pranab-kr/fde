# Server Port (default: 8080)
PORT=8080

# Model to use (e.g. gpt-4o-mini, openrouter/auto, etc.)
OPENAI_MODEL=openrouter/auto

# API Base URL (leave empty for OpenAI, or specify OpenRouter / Ollama / LM Studio)
# Examples:
# OPENAI_ENDPOINT=https://openrouter.ai/api/v1
# OPENAI_ENDPOINT=http://localhost:11434/v1
# OPENAI_ENDPOINT=http://localhost:1234/v1
OPENAI_ENDPOINT=https://openrouter.ai/api/v1

# API Key (your OpenAI or OpenRouter API key)
OPENAI_APIKEY=your_api_key_here
